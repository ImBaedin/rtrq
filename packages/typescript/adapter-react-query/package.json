  },
  "dependencies": {
    "@rtrq/client-core": "workspace:*",
    "@rtrq/shared": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@rtrq/eslint-config": "workspace:*",
    "@rtrq/typescript-config": "workspace:*"
  }
